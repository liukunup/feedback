# 环境变量配置
# Social Feed Aggregator

# ============ 代理配置 ============
# Discord 代理 (Clash Verge 默认端口 7890)
DISCORD_PROXY=http://127.0.0.1:7890

# ============ 数据库 ============
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://app:your_secure_password_here@localhost:5432/social_feed

# ============ Redis ============
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============ AI API Keys (二选一) ============
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ============ 安全 ============
SECRET_KEY=your-random-secret-key-min-32-chars
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ============ Webhook ============
WEBHOOK_BASE_URL=https://your-public-domain.com

# ============ 渠道配置 ============
DISCORD_BOT_TOKEN=your_discord_bot_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# QQ (手机 uiautomator2)
QQ_DEVICE_ID=R3CR12345

# 企业微信 (手机 uiautomator2)
WECOM_DEVICE_ID=R3CR12345
