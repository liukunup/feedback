# src/workers/Dockerfile - Beat (定时任务调度器)
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --no-cache-dir -e .

COPY src/ ./src/

# 启动 Celery Beat (定时任务调度器)
CMD ["celery", "-A", "src.workers.tasks", "beat", "--loglevel=info"]
