# src/workers/Dockerfile
FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e .

# 复制源代码
COPY src/ ./src/

# 启动 Celery Worker
CMD ["celery", "-A", "src.workers.tasks", "worker", "--loglevel=info", "--concurrency=4"]
