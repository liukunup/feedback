# web/Dockerfile - 前端
FROM node:20-alpine AS builder

WORKDIR /app

# 安装依赖
COPY web/package.json web/package-lock.json* ./
RUN npm ci

# 复制源代码
COPY web/ ./

# 构建
RUN npm run build

# 生产镜像
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 nginx 配置
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
